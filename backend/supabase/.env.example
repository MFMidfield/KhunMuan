# Google OAuth client for local development.
# Create one at https://console.cloud.google.com/apis/credentials and add
# http://127.0.0.1:54321/auth/v1/callback as an authorised redirect URI.
# Real values live in supabase/.env, which is gitignored.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Salt for hashing the IPs the tracking rate limit counts. Any long random
# string; `openssl rand -hex 32` is fine. Different per environment — sharing it
# would let one environment's log be correlated with another's.
LOOKUP_IP_SALT=
